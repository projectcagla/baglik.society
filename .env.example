# Copy to .env.local (dev) or set in your host's environment. Never commit real values.

# Postgres connection for the app AND migrations (the table owner).
# Supabase: use the pooler URL (transaction mode, port 6543) for the app.
DATABASE_URL=postgres://baglik:CHANGE_ME@localhost:5432/baglik
# Set to "true" only for a direct (non-pooled) connection.
DB_PREPARE=false

# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_PEPPER=
# 32 random bytes, base64. Encrypts TOTP secrets. Same command as above.
APP_ENCRYPTION_KEY=

# Public origin, used in e-mails and the calendar file.
APP_ORIGIN=http://localhost:3000

# Optional e-mail delivery (Resend HTTP API). Without it nothing is sent and
# deliveries are logged as "saglayici_yok" for the admin.
RESEND_API_KEY=
MAIL_FROM=

# Bearer secret for /api/cron/link-check (Vercel Cron sends it automatically).
CRON_SECRET=
